# Copy to `.env` and fill in. Compose reads `.env` from this directory.
# `.env` holds a real secret: it is gitignored, and .dockerignore keeps it out
# of the image as well.

# Signs the session cookie. Generate your own — never reuse this line:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 once a TLS-terminating reverse proxy is in front of the app. Leave at 0
# while it is served over plain HTTP on localhost, or the session cookie is
# dropped by the browser and flash messages stop appearing.
SESSION_COOKIE_SECURE=0
